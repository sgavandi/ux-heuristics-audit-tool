# -----------------------------------------------------------------------------
# UX Heuristics Audit Tool — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development. Never commit `.env`
# files — they are already listed in .gitignore.
#
# All variables must be prefixed with `VITE_` to be exposed to client code.

# Base URL of the audits API. Leave blank to use the local mock dataset
# shipped under src/services/mockData.js.
#
# Example:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Server-side variables (Vercel deployment only)
# -----------------------------------------------------------------------------
# These are NOT prefixed with VITE_ and are never inlined into the client
# bundle. They are read by the Vercel Edge Middleware at request time.

# Password required to view the deployed site. Username is fixed to `review`.
# Leave empty on preview deployments to skip the Basic Auth gate.
#
# Set via `vercel env add SITE_PASSWORD` — do not commit a real value here.
SITE_PASSWORD=
